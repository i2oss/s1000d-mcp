<?xml version="1.0" encoding="UTF-8"?>
<!--
  s1000d-mcp representative subset schema
  =========================================
  This is a HAND-BUILT, SIMPLIFIED schema that models the structural shape of
  an S1000D data module (identification/status metadata, a DMC, applicability,
  and either descriptive or procedural content). It is NOT one of the official
  S1000D XSDs published by the S1000D Council; those are distributed only
  through the registered-user portal at https://users.s1000d.org/ and are not
  publicly redistributable. This subset exists so the validate_xml_schema tool
  has something real to validate against without requiring that registration,
  while still exercising genuine schema-validation logic (required elements,
  element order, attribute patterns, enumerations) against realistic sample
  data modules. See README.md for details and the roadmap for closing the gap
  with the real schema set.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s1kdmcp="urn:s1000d-mcp:schema-subset:2026"
           targetNamespace="urn:s1000d-mcp:schema-subset:2026"
           elementFormDefault="qualified">

  <!-- ===================== Data Module Code ===================== -->
  <xs:complexType name="dmCodeType">
    <xs:attribute name="modelIdentCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z0-9]{2,14}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="systemDiffCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z0-9]{1,3}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="systemCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{2,3}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="subSystemCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{1}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="subSubSystemCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{1}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="assyCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z0-9]{2,4}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="disassyCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{2}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="disassyCodeVariant" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z0-9]{1,3}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="infoCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z0-9]{3}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="infoCodeVariant" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z]{1}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="itemLocationCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-D]"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="languageType">
    <xs:attribute name="languageIsoCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[a-z]{2}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="countryIsoCode" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z]{2}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="issueInfoType">
    <xs:attribute name="issueNumber" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{3}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="inWork" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{2}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================== identAndStatusSection ===================== -->
  <xs:complexType name="dmIdentType">
    <xs:sequence>
      <xs:element name="dmCode" type="s1kdmcp:dmCodeType"/>
      <xs:element name="language" type="s1kdmcp:languageType"/>
      <xs:element name="issueInfo" type="s1kdmcp:issueInfoType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="issueDateType">
    <xs:attribute name="year" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{4}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="month" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="(0[1-9]|1[0-2])"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="day" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="(0[1-9]|[12][0-9]|3[01])"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="dmTitleType">
    <xs:sequence>
      <xs:element name="techName" type="xs:string"/>
      <xs:element name="infoName" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="dmAddressItemsType">
    <xs:sequence>
      <xs:element name="issueDate" type="s1kdmcp:issueDateType"/>
      <xs:element name="dmTitle" type="s1kdmcp:dmTitleType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="dmAddressType">
    <xs:sequence>
      <xs:element name="dmIdent" type="s1kdmcp:dmIdentType"/>
      <xs:element name="dmAddressItems" type="s1kdmcp:dmAddressItemsType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="securityType">
    <xs:attribute name="securityClassification" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{2}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="enterpriseType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="enterpriseCode" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z0-9]{5}"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="applicType">
    <xs:sequence>
      <xs:element name="displayText" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="brexDmRefType">
    <xs:sequence>
      <xs:element name="dmRefIdent">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="dmCode" type="s1kdmcp:dmCodeType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="qualityAssuranceType">
    <xs:choice>
      <xs:element name="unverified">
        <xs:complexType/>
      </xs:element>
      <xs:element name="verified">
        <xs:complexType/>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="dmStatusType">
    <xs:sequence>
      <xs:element name="security" type="s1kdmcp:securityType"/>
      <xs:element name="responsiblePartnerCompany" type="s1kdmcp:enterpriseType"/>
      <xs:element name="originator" type="s1kdmcp:enterpriseType"/>
      <xs:element name="applic" type="s1kdmcp:applicType"/>
      <xs:element name="brexDmRef" type="s1kdmcp:brexDmRefType" minOccurs="0"/>
      <xs:element name="qualityAssurance" type="s1kdmcp:qualityAssuranceType"/>
    </xs:sequence>
    <xs:attribute name="issueType" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="new"/>
          <xs:enumeration value="changed"/>
          <xs:enumeration value="revised"/>
          <xs:enumeration value="deleted"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="identAndStatusSectionType">
    <xs:sequence>
      <xs:element name="dmAddress" type="s1kdmcp:dmAddressType"/>
      <xs:element name="dmStatus" type="s1kdmcp:dmStatusType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== content ===================== -->
  <xs:complexType name="graphicRefType">
    <xs:attribute name="infoEntityIdent" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="ICN-[A-Z0-9]{5,14}-[0-9]{3}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="dmRefType">
    <xs:sequence>
      <xs:element name="dmRefIdent">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="dmCode" type="s1kdmcp:dmCodeType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Mixed-content paragraph: plain text plus inline cross-references,
       so check_cross_references (week 3) has real dmRef/graphicRef targets
       to parse out of content. -->
  <xs:complexType name="paraType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="dmRef" type="s1kdmcp:dmRefType"/>
      <xs:element name="graphicRef" type="s1kdmcp:graphicRefType"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="descriptionType">
    <xs:sequence>
      <xs:element name="para" type="s1kdmcp:paraType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="proceduralStepType">
    <xs:sequence>
      <xs:element name="para" type="s1kdmcp:paraType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="mainProcedureType">
    <xs:sequence>
      <xs:element name="proceduralStep" type="s1kdmcp:proceduralStepType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="procedureType">
    <xs:sequence>
      <xs:element name="preliminaryRqmts" type="s1kdmcp:paraType" minOccurs="0"/>
      <xs:element name="mainProcedure" type="s1kdmcp:mainProcedureType"/>
      <xs:element name="closeRqmts" type="s1kdmcp:paraType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="contentType">
    <xs:choice>
      <xs:element name="description" type="s1kdmcp:descriptionType"/>
      <xs:element name="procedure" type="s1kdmcp:procedureType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================== root ===================== -->
  <xs:element name="dmodule">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identAndStatusSection" type="s1kdmcp:identAndStatusSectionType"/>
        <xs:element name="content" type="s1kdmcp:contentType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
