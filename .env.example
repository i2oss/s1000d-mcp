# Copy this file to .env and fill in your own key. .env is gitignored and
# is never read by anything except your local environment -- the key is
# never sent anywhere but the Anthropic API, and never committed.

# Required for the suggest_fix tool. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5 if unset. Any valid Claude model
# ID/alias can go here (e.g. claude-sonnet-4-5) to use a different model
# for suggest_fix.
ANTHROPIC_MODEL=claude-haiku-4-5
